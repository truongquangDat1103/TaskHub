# PostgreSQL 16 (Default for Docker / Production)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/taskhub
# Or MySQL 8:
# DATABASE_URL=mysql+aiomysql://USERNAME:PASSWORD@127.0.0.1:3306/taskhub?charset=utf8mb4
# Or SQLite (Development/Test):
# DATABASE_URL=sqlite+aiosqlite:///./taskhub.db

JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://127.0.0.1:6379/0
TASK_CACHE_TTL_SECONDS=300
